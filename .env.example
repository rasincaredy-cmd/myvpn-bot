# --- Telegram ---
BOT_TOKEN=

# Список Telegram user_id админов через запятую (минимум один — твой)
ADMIN_IDS=

# --- БД ---
# По умолчанию SQLite в ./data/vpn_bot.sqlite3
DB_URL=sqlite+aiosqlite:///./data/vpn_bot.sqlite3

# --- Шифрование SSH-кредов в БД ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Логирование ---
LOG_LEVEL=INFO

# --- SSH ---
SSH_CONNECT_TIMEOUT=20
SSH_COMMAND_TIMEOUT=900

# --- AmneziaWG ---
# Порт по умолчанию, рекомендация документации Amnezia: 585 или 1234
DEFAULT_AMNEZIA_PORT=585

# --- Журнал действий ---
# Сколько дней хранится журнал действий (0 — хранить вечно)
AUDIT_RETENTION_DAYS=90

# --- Цены, ₽/мес ---
# Первая позиция тарифа (устройство ИЛИ резервное подключение) — это пол
# тарифа, дешевле не бывает. Каждая следующая позиция прибавляется по своей
# цене. Отсюда: 1 устройство = 90, 1 устройство + 1 подключение = 120,
# 2 устройства + 1 подключение = 160.
PRICE_FIRST_RUB=90
PRICE_EXTRA_DEVICE_RUB=40
PRICE_EXTRA_BYPASS_RUB=30

# --- Оплата звёздами Telegram ---
# Курс плавает (звезда привязана к доллару), поэтому он в настройках, а не в
# коде. Наценка компенсирует то, что звёзды доходят до владельца дороже рублей:
# вывод через Fragment, комиссии, холд около трёх недель. При 25 % тариф за
# 120 ₽ стоит 150 ⭐. Настройка не обязательна: способ работает и на значениях
# по умолчанию, токен ему не нужен.
STAR_PRICE_KOPEKS=100
STAR_MARKUP_PERCENT=25

# --- Пробный период ---
# Что новый юзер получает бесплатно. По составу совпадает с тарифом за 120 ₽
# (1+1) и отличается сроком и лимитом трафика — щедрее платного делать нельзя,
# иначе платить незачем.
TRIAL_DEVICES=1
TRIAL_BYPASS=1
TRIAL_DAYS=7
# Лимит трафика на пробный период, ГБ (0 = безлимит)
TRIAL_TRAFFIC_GB=10

# --- Юридические документы (требование платёжного провайдера) ---
# Адреса страниц на telegra.ph. Пусто = кнопки в меню не показываются.
LEGAL_PRIVACY_URL=
LEGAL_TERMS_URL=
# Токен telegra.ph для ПРАВКИ опубликованных страниц (без него правка создаёт
# новый адрес, старый остаётся с устаревшим текстом).
TELEGRAPH_TOKEN=

# Платёжный провайдер Platega (карта/СБП/крипта одной формой). Ключи — в личном
# кабинете platega.io, раздел «Настройки проекта». Пусто = способ выключен.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Порт локального приёмника уведомлений об оплате; наружу его выставляет nginx
# с TLS (см. scripts/nginx-webhook.conf). 0 = приёмника нет, статусы добирает
# поллинг — деньги дойдут, но зачисление будет ждать до пяти минут.
WEBHOOK_PORT=0
# Путь к сертификату приёмника — бот следит за сроком и поднимает тревогу за
# полтора дня до конца. Обычно задавать не надо: он находит его сам. Заполнять
# только если в /etc/letsencrypt/live лежит больше одной папки.
WEBHOOK_CERT_PATH=
